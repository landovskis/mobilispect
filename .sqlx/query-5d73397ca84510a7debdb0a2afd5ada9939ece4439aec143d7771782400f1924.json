{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id AS corridor_id, c.geometry_source, c.created_at, c.updated_at,\n                  cs.id AS cross_section_id, cs.lat, cs.lon\n           FROM corridors c\n           JOIN cross_sections cs ON cs.corridor_id = c.id\n           WHERE c.remix_id = $1\n           ORDER BY c.id, cs.position",
