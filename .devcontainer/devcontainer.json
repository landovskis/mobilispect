{
  "name": "Mobilispect Workspace",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces",
  "postAttachCommand": {
    "Install frontend deps": "cd frontend/web && npm install"
  },
  "forwardPorts": [8080, 4200, 5432, 6379],
  "remoteEnv": {
    "GRADLE_USER_HOME": "/workspaces/.gradle-user-home"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.watcherExclude": {
          "**/.gradle": true,
          "**/node_modules": true
        },
        "kotlin.languageServer.enabled": true,
        "typescript.tsdk": "frontend/web/node_modules/typescript/lib"
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "mathiasfrohlich.Kotlin",
        "vscjava.vscode-gradle",
        "pivotal.vscode-spring-boot",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "angular.ng-template",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
