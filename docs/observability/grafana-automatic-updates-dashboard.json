{
  "dashboard": {
    "id": null,
    "title": "Feed Management - Automatic Updates",
    "tags": ["feed-management", "automatic-updates", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Automatic Import Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "(sum(rate(feed_import_success_total{trigger_type=\"AUTOMATIC\"}[5m])) / sum(rate(feed_import_total{trigger_type=\"AUTOMATIC\"}[5m]))) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 80
                },
                {
                  "color": "green",
                  "value": 95
                }
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Active Automatic Imports",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(feed_import_active_count{trigger_type=\"AUTOMATIC\"})",
            "legendFormat": "Active Imports"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 3
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Scheduler Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"feed-scheduler\"}",
            "legendFormat": "Scheduler Up"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "DOWN"
                  },
                  "1": {
                    "text": "UP"
                  }
                },
                "type": "value"
              }
            ]
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Time Since Last Automatic Update",
        "type": "stat",
        "targets": [
          {
            "expr": "(time() - last_over_time(feed_import_total{trigger_type=\"AUTOMATIC\"}[2d])) / 3600",
            "legendFormat": "Hours Since Last Update"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 25
                },
                {
                  "color": "red",
                  "value": 48
                }
              ]
            },
            "unit": "h"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Automatic Import Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(feed_import_total{trigger_type=\"AUTOMATIC\"}[5m])",
            "legendFormat": "Import Rate"
          },
          {
            "expr": "rate(feed_import_success_total{trigger_type=\"AUTOMATIC\"}[5m])",
            "legendFormat": "Success Rate"
          },
          {
            "expr": "rate(feed_import_failure_total{trigger_type=\"AUTOMATIC\"}[5m])",
            "legendFormat": "Failure Rate"
          }
        ],
        "yAxes": [
          {
            "label": "Imports per second",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 6,
        "title": "Import Duration Distribution",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.5, rate(feed_import_duration_seconds_bucket{trigger_type=\"AUTOMATIC\"}[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.95, rate(feed_import_duration_seconds_bucket{trigger_type=\"AUTOMATIC\"}[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, rate(feed_import_duration_seconds_bucket{trigger_type=\"AUTOMATIC\"}[5m]))",
            "legendFormat": "99th percentile"
          }
        ],
        "yAxes": [
          {
            "label": "Duration (seconds)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 7,
        "title": "Transit.land API Health",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(transitland_api_requests_total[5m])",
            "legendFormat": "Total Requests"
          },
          {
            "expr": "rate(transitland_api_request_failures_total[5m])",
            "legendFormat": "Failed Requests"
          }
        ],
        "yAxes": [
          {
            "label": "Requests per second",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 8,
        "title": "Recent Automatic Import Failures",
        "type": "table",
        "targets": [
          {
            "expr": "increase(feed_import_failure_total{trigger_type=\"AUTOMATIC\"}[1h])",
            "legendFormat": "{{region}} - {{feed_id}}",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      },
      {
        "id": 9,
        "title": "Feed Version Check Status",
        "type": "heatmap",
        "targets": [
          {
            "expr": "feed_version_check_duration_seconds_bucket",
            "legendFormat": "Version Check Duration"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        }
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 1,
    "links": []
  }
}