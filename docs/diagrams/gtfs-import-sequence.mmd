sequenceDiagram
    actor User
    participant UI as Frontend UI
    participant API as ImportController
    participant Service as FeedImportService
    participant Batch as Spring Batch
    participant Tasklet as FeedImportTasklet
    participant Processor as FeedManagementImportProcessor
    participant Downloader as Downloader (curl)
    participant Extractor as ArchiveExtractor
    participant Parser as ConveyalGtfsParser
    participant Domain as TransitAnalysisFeedImportService
    participant VariantSvc as VariantIdentificationService
    participant FreqSvc as FrequencyCalculationService
    participant CommonSvc as CommonSectionDetectionService
    participant SpacingSvc as StopSpacingCalculationService
    participant DB as PostgreSQL
    participant WS as WebSocket (Progress)
    participant Events as EventPublisher

    %% API Request
    User->>UI: Click "Import Feed"
    UI->>API: POST /api/feeds/{feedOnestopId}/import

    %% Create Import Record
    API->>DB: Save FeedImport (status=RUNNING)
    DB-->>API: FeedImport entity
    API->>WS: updateProgress(0%, "Starting import")

    %% Launch Async Job
    API->>Service: startImport(feedOnestopId)
    Service->>Batch: JobLauncher.run(feedImportJob)
    Note over Service,Batch: Async execution via TaskExecutor
    Service-->>API: FeedImport entity
    API-->>UI: 200 OK (import started)
    UI->>WS: Subscribe to progress updates

    %% Spring Batch Execution
    Batch->>Tasklet: execute(feedOnestopId, importId)
    Tasklet->>Processor: importFeedById(feedOnestopId)

    %% Download Phase
    Processor->>WS: updateProgress(12%, "Downloading feed")
    WS-->>UI: Progress update
    Processor->>DB: Find feed by onestop ID
    DB-->>Processor: FeedEntity
    Processor->>Downloader: download(feed.downloadUrl)
    Downloader-->>Processor: Path (archive.zip)

    %% Extract Phase
    Processor->>WS: updateProgress(25%, "Extracting feed")
    WS-->>UI: Progress update
    Processor->>Extractor: extract(archive.zip)
    Extractor-->>Processor: Path (extracted directory)

    %% Validate Phase
    Processor->>WS: updateProgress(37%, "Validating GTFS files")
    WS-->>UI: Progress update
    Processor->>Processor: validateGtfsFiles(directory)
    Note over Processor: Check for required files:<br/>agency.txt, stops.txt,<br/>routes.txt, trips.txt,<br/>stop_times.txt

    %% Parse Phase
    Processor->>WS: updateProgress(50%, "Processing GTFS data")
    WS-->>UI: Progress update
    Processor->>Domain: importFeed(feedPath, feedEntity)
    Domain->>Parser: parse(feedPath)

    Parser->>Parser: GTFSFeed.fromFile()
    Note over Parser: Conveyal gtfs-lib with MapDB<br/>Parses all GTFS files
    Parser->>Parser: Parse agencies, routes, stops,<br/>trips, stop_times, shapes
    Parser-->>Domain: ParsedGtfsData

    %% Persist Agencies
    Domain->>DB: Find/Create Agencies
    Note over Domain,DB: Generate Onestop IDs:<br/>o-{geohash}-{agency_name}
    DB-->>Domain: Agency entities

    %% Persist Routes
    Domain->>DB: Find/Create Routes
    Note over Domain,DB: Generate Onestop IDs:<br/>r-{geohash}-{route_id}
    DB-->>Domain: Route entities

    %% Persist Stops
    Domain->>DB: Save Stops
    DB-->>Domain: Stop entities map

    %% Variant Identification
    Domain->>VariantSvc: identifyVariants(trips, stops, shapes)

    loop For each Trip
        VariantSvc->>VariantSvc: Extract stop sequence
        VariantSvc->>VariantSvc: Generate variant hash

        alt New Variant
            VariantSvc->>SpacingSvc: calculateAverageSpacingKm(trip, stops, shapes)

            alt Tier 1: Pre-calculated distances
                SpacingSvc->>SpacingSvc: Check stop_times.shape_dist_traveled
                Note over SpacingSvc: If all stops have distances,<br/>use pre-calculated values
            else Tier 2: Shape projection
                SpacingSvc->>SpacingSvc: buildCumulativeDistances(shapes)
                loop For each Stop
                    SpacingSvc->>SpacingSvc: projectPointOntoSegment()
                    Note over SpacingSvc: Perpendicular projection<br/>onto route geometry
                end
            else Tier 3: No shapes
                SpacingSvc-->>VariantSvc: null (no spacing data)
            end

            SpacingSvc-->>VariantSvc: averageStopSpacingKm
            VariantSvc->>VariantSvc: Create RouteVariant entity
        end
    end

    VariantSvc-->>Domain: List<RouteVariant>

    %% Persist Variants
    loop For each Variant
        Domain->>DB: Save RouteVariant
        Domain->>Events: Publish RouteVariantIdentified
        Domain->>DB: Link stops to variant (junction table)
    end

    %% Frequency Calculation
    loop For each Variant
        Domain->>FreqSvc: calculateFrequency(variant, departureTimes)
        FreqSvc->>FreqSvc: Calculate headways per time period
        FreqSvc-->>Domain: Frequency entity
        Domain->>DB: Save Frequency
        Domain->>Events: Publish FrequencyCalculationCompleted
    end

    %% Common Section Detection
    Domain->>CommonSvc: detectCommonSections(variants)
    CommonSvc->>CommonSvc: Find shared route segments
    CommonSvc->>DB: Save CommonSections

    %% Publish Events
    Domain->>Events: Publish FeedImportCompleted
    Domain-->>Processor: ImportResult(stats)

    %% Complete Import
    Processor->>WS: updateProgress(100%, "Finalizing import")
    WS-->>UI: Progress update
    Processor->>Processor: Cleanup archive files
    Processor-->>Tasklet: Result.success(versionSha1)

    Tasklet->>Service: completeImport(importId)
    Service->>DB: Update FeedImport (status=COMPLETED)
    Service->>DB: Update Feed (status=ACTIVE)
    Service->>WS: markCompleted(importId)
    WS-->>UI: Import completed!

    Tasklet-->>Batch: RepeatStatus.FINISHED
    Batch-->>Batch: Job completed

    %% Error Path
    alt Import Failure
        Processor--XTasklet: Result.failure(error)
        Tasklet->>Service: failImport(importId, message)
        Service->>DB: Update FeedImport (status=FAILED)
        Service->>WS: markFailed(importId, message)
        WS-->>UI: Import failed
        Tasklet-->>Batch: ExitStatus.FAILED
    end
