@startuml Feed Management System Architecture

!theme aws-orange
title Feed Management System - High-Level Architecture

package "Frontend (Angular)" {
  [Feed Management UI] as FME
  [Region List Component] as RLC
  [Import Progress Dialog] as IPD
  [Active Imports Display] as AID
}

package "Authentication & Security" {
  [Auth Guards] as AG
  [Auth Service] as AS
  [Auth Interceptor] as AI
}

package "Backend Services (Spring Boot)" {
  [Feed Management API] as FMA
  [Import Service] as IS
  [Progress Service] as PS
  [Authentication Service] as AUS
}

package "External Integration" {
  [Transit.land API Client] as TAC
  [GTFS Downloader] as GD
  [Feed Validator] as FV
}

package "Data Layer" {
  database "PostgreSQL" {
    [Feed Import Tables] as FIT
    [User & Role Tables] as URT
    [Audit Log Tables] as ALT
  }

  database "Redis" {
    [Progress Cache] as PC
    [Session Storage] as SS
  }
}

package "Infrastructure" {
  [WebSocket Server] as WSS
  [File Storage] as FS
  [Metrics & Monitoring] as MM
}

package "External Services" {
  [Transit.land API] as TLA
  [GTFS Feed Servers] as GFS
}

' Frontend to Backend connections
FME --> FMA : REST API
IPD --> PS : WebSocket
AID --> IS : HTTP Polling

' Authentication flow
FME --> AG : Route Protection
AG --> AS : User Validation
AS --> AI : Token Management
AI --> FMA : JWT Headers

' Backend service interactions
FMA --> IS : Import Management
IS --> PS : Progress Updates
IS --> TAC : Feed Discovery
TAC --> TLA : API Calls

' Import process flow
IS --> GD : Download GTFS
GD --> GFS : Fetch Files
IS --> FV : Validate Data
IS --> FIT : Store Results

' Real-time updates
PS --> WSS : Progress Events
WSS --> IPD : Live Updates
PS --> PC : Cache Updates

' Authentication backend
AUS --> URT : User Management
AUS --> SS : Session Storage

' Monitoring and observability
FMA --> MM : Metrics
IS --> MM : Import Metrics
TAC --> MM : API Metrics

' Data persistence
IS --> FIT : Import Records
PS --> PC : Progress Data
AUS --> URT : User Data
FMA --> ALT : Audit Trail

@enduml