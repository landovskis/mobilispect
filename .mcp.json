{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/postgres-mcp",
        "postgresql://mobilispect:mobilispect@localhost:5432/mobilispect"
      ]
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@anthropic/docker-mcp"]
    }
  }
}
