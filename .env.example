# Copy to .env and fill in your values.
#
# ─── Agency configuration ──────────────────────────────────────────────────────
#
# OPTION A — Legacy single-agency format (backward compatible, still works).
#   Set AGENCY_NAME and the flat GTFS_* variables below.
#   If AGENCY_0_SLUG is NOT present, these flat vars are used automatically.

AGENCY_NAME=STM

# STM static GTFS (no auth required)
GTFS_STATIC_URL=https://www.stm.info/sites/default/files/gtfs/gtfs_stm.zip

# STM GTFS-RT (requires API key from stm.info/developers)
GTFS_RT_VEHICLE_POSITIONS_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/vehiclePositions
GTFS_RT_TRIP_UPDATES_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/tripUpdates
GTFS_API_KEY=your_stm_api_key_here

# Agency timezone UTC offset (e.g. -05:00 EST, -04:00 EDT)
# Montreal: -05:00 in winter, -04:00 Apr–Oct (DST)
AGENCY_UTC_OFFSET=-04:00

# ─── OPTION B — Multi-agency format ───────────────────────────────────────────
#
# Define agencies via indexed env vars.  Presence of AGENCY_0_SLUG switches the
# app into multi-agency mode; the flat vars above are then ignored.
# Add consecutive indices (0, 1, 2, …) until no SLUG is set for the next index.
#
# Example: two agencies — STM and OC Transpo
#
# AGENCY_0_SLUG=stm
# AGENCY_0_NAME=STM
# AGENCY_0_GTFS_STATIC_URL=https://www.stm.info/sites/default/files/gtfs/gtfs_stm.zip
# AGENCY_0_GTFS_RT_VEHICLE_POSITIONS_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/vehiclePositions
# AGENCY_0_GTFS_RT_TRIP_UPDATES_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/tripUpdates
# AGENCY_0_GTFS_API_KEY=your_stm_api_key_here
# AGENCY_0_UTC_OFFSET=-04:00
#
# AGENCY_1_SLUG=octranspo
# AGENCY_1_NAME=OC Transpo
# AGENCY_1_GTFS_STATIC_URL=https://www.octranspo.com/files/google_transit.zip
# AGENCY_1_GTFS_RT_VEHICLE_POSITIONS_URL=https://api.octranspo1.com/v2.0/Gtfs-rt/GtfsRealtimeVehiclePositions
# AGENCY_1_GTFS_RT_TRIP_UPDATES_URL=https://api.octransco1.com/v2.0/Gtfs-rt/GtfsRealtimeTripUpdates
# AGENCY_1_GTFS_API_KEY=your_octranspo_api_key_here
# AGENCY_1_UTC_OFFSET=-04:00
#
# ─── Montreal Metropolitan Region ─────────────────────────────────────────────
#
# Four transit operators with verified GTFS-RT feeds (as of 2026-04-05).
# All URLs below return HTTP 200 and have been tested.
#
# STM  — API key required: https://www.stm.info/en/about/developers
# RTL  — open, no key: https://www.rtl-longueuil.qc.ca/en-CA/open-data/
# STL  — open, no key: https://www.stlaval.ca/en/about-us/publications-and-documents/open-data
# exo  — open, no key: https://exo.quebec/en/about/open-data
#         Note: exo publishes one static GTFS per network (trains, 11 bus sectors).
#         The GTFS-RT feed is combined across all networks. Add each network as
#         a separate agency entry using the same RT URLs but a different static URL.
#         Static URLs: https://exo.quebec/xdata/{network}/google_transit.zip
#         Known network slugs: trains, citso, citla, citpi, citsv, citvr, citcrc,
#                              citrous, citlr, mrclm, mrclasso, lrrs
#
# AGENCY_0_SLUG=stm
# AGENCY_0_NAME=STM
# AGENCY_0_GTFS_STATIC_URL=https://www.stm.info/sites/default/files/gtfs/gtfs_stm.zip
# AGENCY_0_GTFS_RT_VEHICLE_POSITIONS_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/vehiclePositions
# AGENCY_0_GTFS_RT_TRIP_UPDATES_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/tripUpdates
# AGENCY_0_GTFS_API_KEY=your_stm_api_key_here
# AGENCY_0_UTC_OFFSET=-04:00
#
# AGENCY_1_SLUG=rtl
# AGENCY_1_NAME=RTL
# AGENCY_1_GTFS_STATIC_URL=https://www.rtl-longueuil.qc.ca/transit/latestfeed/gtfs.zip
# AGENCY_1_GTFS_RT_VEHICLE_POSITIONS_URL=https://www.rtl-longueuil.qc.ca/transit/latestfeed/gtfs-rt/vehiclePositions.pb
# AGENCY_1_GTFS_RT_TRIP_UPDATES_URL=https://www.rtl-longueuil.qc.ca/transit/latestfeed/gtfs-rt/tripUpdates.pb
# AGENCY_1_UTC_OFFSET=-04:00
#
# AGENCY_2_SLUG=stl
# AGENCY_2_NAME=STL
# AGENCY_2_GTFS_STATIC_URL=https://www.stlaval.ca/assets/upload/transit/google_transit.zip
# AGENCY_2_GTFS_RT_VEHICLE_POSITIONS_URL=https://www.stlaval.ca/assets/upload/transit/gtfs-rt/vehiclePositions.pb
# AGENCY_2_GTFS_RT_TRIP_UPDATES_URL=https://www.stlaval.ca/assets/upload/transit/gtfs-rt/tripUpdates.pb
# AGENCY_2_UTC_OFFSET=-04:00
#
# AGENCY_3_SLUG=exo-trains
# AGENCY_3_NAME=exo (trains)
# AGENCY_3_GTFS_STATIC_URL=https://exo.quebec/xdata/trains/google_transit.zip
# AGENCY_3_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_3_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_3_UTC_OFFSET=-04:00
#
# Add more exo bus networks by repeating the pattern with the next index:
# AGENCY_4_SLUG=exo-citso
# AGENCY_4_NAME=exo (Sud-Ouest)
# AGENCY_4_GTFS_STATIC_URL=https://exo.quebec/xdata/citso/google_transit.zip
# AGENCY_4_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_4_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_4_UTC_OFFSET=-04:00
#
# AGENCY_5_SLUG=exo-citla
# AGENCY_5_NAME=exo (Laval)
# AGENCY_5_GTFS_STATIC_URL=https://exo.quebec/xdata/citla/google_transit.zip
# AGENCY_5_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_5_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_5_UTC_OFFSET=-04:00
#
# AGENCY_6_SLUG=exo-citpi
# AGENCY_6_NAME=exo (Presqu'île)
# AGENCY_6_GTFS_STATIC_URL=https://exo.quebec/xdata/citpi/google_transit.zip
# AGENCY_6_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_6_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_6_UTC_OFFSET=-04:00
#
# AGENCY_7_SLUG=exo-citsv
# AGENCY_7_NAME=exo (Sorel-Varennes)
# AGENCY_7_GTFS_STATIC_URL=https://exo.quebec/xdata/citsv/google_transit.zip
# AGENCY_7_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_7_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_7_UTC_OFFSET=-04:00
#
# AGENCY_8_SLUG=exo-citvr
# AGENCY_8_NAME=exo (Vallée-du-Richelieu)
# AGENCY_8_GTFS_STATIC_URL=https://exo.quebec/xdata/citvr/google_transit.zip
# AGENCY_8_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_8_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_8_UTC_OFFSET=-04:00
#
# AGENCY_9_SLUG=exo-citcrc
# AGENCY_9_NAME=exo (Chambly-Richelieu-Carignan)
# AGENCY_9_GTFS_STATIC_URL=https://exo.quebec/xdata/citcrc/google_transit.zip
# AGENCY_9_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_9_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_9_UTC_OFFSET=-04:00
#
# AGENCY_10_SLUG=exo-citrous
# AGENCY_10_NAME=exo (Roussillon)
# AGENCY_10_GTFS_STATIC_URL=https://exo.quebec/xdata/citrous/google_transit.zip
# AGENCY_10_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_10_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_10_UTC_OFFSET=-04:00
#
# AGENCY_11_SLUG=exo-citlr
# AGENCY_11_NAME=exo (Le Richelain)
# AGENCY_11_GTFS_STATIC_URL=https://exo.quebec/xdata/citlr/google_transit.zip
# AGENCY_11_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_11_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_11_UTC_OFFSET=-04:00
#
# AGENCY_12_SLUG=exo-mrclm
# AGENCY_12_NAME=exo (Laurentides-Mirabel)
# AGENCY_12_GTFS_STATIC_URL=https://exo.quebec/xdata/mrclm/google_transit.zip
# AGENCY_12_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_12_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_12_UTC_OFFSET=-04:00
#
# AGENCY_13_SLUG=exo-mrclasso
# AGENCY_13_NAME=exo (Assomption)
# AGENCY_13_GTFS_STATIC_URL=https://exo.quebec/xdata/mrclasso/google_transit.zip
# AGENCY_13_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_13_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_13_UTC_OFFSET=-04:00
#
# AGENCY_14_SLUG=exo-lrrs
# AGENCY_14_NAME=exo (Haut-Saint-Laurent)
# AGENCY_14_GTFS_STATIC_URL=https://exo.quebec/xdata/lrrs/google_transit.zip
# AGENCY_14_GTFS_RT_VEHICLE_POSITIONS_URL=https://opendata.exo.quebec/ServiceGTFSR/VehiclePosition.pb
# AGENCY_14_GTFS_RT_TRIP_UPDATES_URL=https://opendata.exo.quebec/ServiceGTFSR/TripUpdate.pb
# AGENCY_14_UTC_OFFSET=-04:00
#
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=sqlite://mobilispect.db

# How often to poll GTFS-RT (seconds)
POLL_INTERVAL_SECS=30

# Web server
BIND_ADDRESS=0.0.0.0:3000

# On-time thresholds (seconds; -60 = 1 min early, 300 = 5 min late)
ON_TIME_EARLY_THRESHOLD_SECS=-60
ON_TIME_LATE_THRESHOLD_SECS=300

# Data retention: rows older than this many days are deleted daily
RETENTION_DAYS=30

# Log level: error, warn, info, debug, trace
RUST_LOG=mobilispect=info
