# dotenvx secrets referenced by config.toml.
#
# Keep non-secret application structure in config.toml. Put only secret values
# here, then run the app with:
#
#   dotenvx run -- cargo run --bin mobilispect-server
#   dotenvx run -- cargo run --bin mobilispect-worker

MOBILISPECT_DATABASE_URL=postgres://mobilispect:mobilispect@localhost:5433/mobilispect
STM_GTFS_RT_API_KEY=your_stm_api_key_here
